#!/bin/bash
# Abre o Audiobook Generator with AI. Usa o Electron da pasta do app (mais rápido); sem ele, usa o npx
cd "$(dirname "$0")"
unset ELECTRON_RUN_AS_NODE
if [ -x "./node_modules/.bin/electron" ]; then
  exec ./node_modules/.bin/electron electron-main.cjs
fi
exec npx electron electron-main.cjs
