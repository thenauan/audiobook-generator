#!/bin/bash
# Abre o Audiobook Generator with AI (pasta do app: 3 níveis acima de Contents/MacOS)
APP_DIR="$(cd "$(dirname "$0")/../../.." && pwd)"
cd "$APP_DIR"
# Caminhos comuns do Node no Mac (Homebrew em Intel e Apple Silicon)
export PATH="/usr/local/bin:/opt/homebrew/bin:$PATH"
unset ELECTRON_RUN_AS_NODE
if [ -x "./node_modules/.bin/electron" ]; then
  exec ./node_modules/.bin/electron electron-main.cjs
fi
exec npx electron electron-main.cjs
