{
  "name": "audiobook-generator",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "main": "electron-main.cjs",
  "scripts": {
    "start": "node scripts/start.mjs",
    "dev": "npx esbuild server.ts --bundle --platform=node --format=esm --outfile=server.mjs --external:express --external:vite --external:multer --external:@vitejs/plugin-react --external:@tailwindcss/vite && node server.mjs --dev",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "clsx": "^2.1.1",
    "express": "^4.21.2",
    "howler": "^2.2.4",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "multer": "^1.4.5-lts.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-icons": "^5.6.0",
    "tailwind-merge": "^3.5.0",
    "vite": "^6.2.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/howler": "^2.2.12",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "electron": "^34.2.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  },
  "description": "Converte e-books em audiobooks com vozes neurais e gera textos sincronizados."
}
